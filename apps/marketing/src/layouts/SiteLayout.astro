---
// The document shell every Cadsense-styled page shares: the head, the fonts, the theme tokens and the
// few global classes below. It renders no chrome of its own. A page places SiteNav and SiteFooter
// itself, because the home page lays its hero art under the nav.
// The theme is the app's dark neutral, with blue as the site's accent. The amber pins and the
// severity colours are the app's own, so comments look here as they do there.
// The older Layout.astro still carries T3 Code's nav and links; the pages on it have not moved yet.
// Slot `head` takes extra tags for the document head.
import Analytics from "@vercel/analytics/astro";

interface Props {
  readonly title: string;
  readonly description: string;
  /** The image link previews show. */
  readonly image?: string;
  /** The Open Graph type: "article" for a post. */
  readonly type?: "website" | "article";
  /** Keeps search engines from indexing the page. */
  readonly noindex?: boolean;
}

const { title, description, image = "/cadsense-icon.png", type = "website", noindex = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <slot name="head" />
    <script is:inline>
      // Names the visitor's desktop platform on <html> as data-platform="mac", "windows" or "linux",
      // so platform-specific pieces (the download button's icon) are right in the first paint. It
      // stays unset on phones, tablets and anything else. Read it from CSS: [data-platform="mac"].
      (() => {
        const source = navigator.userAgentData?.platform || navigator.platform || navigator.userAgent;
        const mac = /Mac/i.test(source);
        // Android reports "Linux" and iPadOS reports "MacIntel", so rule out touch devices first.
        const handheld = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || (mac && navigator.maxTouchPoints > 1);
        const platform = handheld ? undefined : /Win/i.test(source) ? "windows" : mac ? "mac" : /Linux|X11/i.test(source) ? "linux" : undefined;
        if (platform) document.documentElement.dataset.platform = platform;
      })();
    </script>
    <link rel="icon" href="/cadsense-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/cadsense-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --page: #111213;
    --elev: #18191b;
    --row: rgb(255 255 255 / 0.05);
    --divide: rgb(255 255 255 / 0.09);
    --text: #f4f5f7;
    --text-2: #a3a7ad;
    --dim: rgb(244 245 247 / 0.46);
    --accent: #8fb8f6;
    /* Hover states, shared by every control. A glass control gets a brighter fill and edge. Anything
       that sits on a surface gets a tint. The white button turns the accent's pale blue and grows a
       halo. Text links go to the accent, and their arrows move the way they point. */
    --raise: #242527;
    --line-hover: rgb(255 255 255 / 0.24);
    /* Glass: the see-through controls (see .glass). A half-clear fill in the page's colour, over a
       blur of whatever is behind it. */
    --glass-fill: color-mix(in oklab, var(--page) 50%, transparent);
    --glass-fill-hover: color-mix(in oklab, var(--raise) 62%, transparent);
    --glass-blur: blur(12px);
    --tint: rgb(255 255 255 / 0.08);
    --primary-hover: #c9ddfb;
    --halo: 0 0 0 4px rgb(143 184 246 / 0.28);
    --ease: 0.16s ease-out;
    /* Corner radii. Every rounded corner on the site uses one of these, so shapes match. The site is
       squarish: nothing is a full pill except the launch post chip and the app's own comment pins.
       panel: the large framed surfaces. card: what sits inside a panel, and cards that stand alone.
       control: buttons and the capsules that hold links or logos. tile: small boxes and rows inside
       a card. chip: what sits inside a control, and marks under about 24 px, such as the logo. */
    --round-pill: 999px;
    --round-panel: 16px;
    --round-card: 10px;
    --round-control: 10px;
    --round-tile: 7px;
    --round-chip: 5px;
    /* The app's pin and severity colours (apps/web/src/index.css). */
    --flag: #fcd34d;
    --error: oklch(0.710712 0.181847 24.751);
    --warning: oklch(0.7631 0.149218 44.196);
    --question: #7dbbff;
    --nit: #8f8f8f;
    --sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --mono: "JetBrains Mono", ui-monospace, "Cascadia Code", Consolas, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    overflow-x: clip;
    background: var(--page);
    color: var(--text);
    font: 400 16px/1.5 var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* A band is a rule across the page. A frame inside it holds the content, and its side borders run
     down the content edges. `flush` drops the frame's padding so a grid inside can reach the edges. */
  .band {
    border-top: 1px solid var(--divide);
  }

  .frame {
    max-width: 1240px;
    margin: 0 auto;
    padding: 104px 58px;
    border-inline: 1px solid var(--divide);
  }

  .frame.flush {
    padding: 0;
  }

  /* The logo and name, in the nav and the footer. */
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 16px;
    font-weight: 500;
  }

  .brand img {
    border-radius: var(--round-chip);
  }

  /* An accent link that ends in an arrow: <a class="more">Label <span>›</span></a>. */
  .more {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
    transition: color var(--ease);
  }

  .more span {
    display: inline-block;
    transition: translate var(--ease);
  }

  .more:hover {
    color: #c3d9fb;
  }

  .more:hover span {
    translate: 3px 0;
  }

  /* A link drawn as a button. Add `primary` for the white one and `small` for the nav's size. */
  .button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 24px;
    border: 1px solid transparent;
    border-radius: var(--round-control);
    font-size: 15px;
    font-weight: 500;
    transition:
      background-color var(--ease),
      border-color var(--ease),
      box-shadow var(--ease);
  }

  /* Frosted glass, for every see-through control: the plain button, and anything with class `glass`
     (the nav's capsule, the launch chip, the logo capsules). Whatever is behind it shows through
     blurred. The blur is over static content, so it is painted once and again only on scroll. */
  .glass,
  .button:not(.primary) {
    border: 1px solid var(--divide);
    background-color: var(--glass-fill);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }

  a.glass {
    transition:
      background-color var(--ease),
      border-color var(--ease);
  }

  a.glass:hover,
  .button:not(.primary):hover {
    border-color: var(--line-hover);
    background-color: var(--glass-fill-hover);
  }

  .button.small {
    padding: 8px 16px;
    font-size: 14px;
  }

  .button.primary {
    border-color: transparent;
    background: var(--text);
    color: var(--page);
  }

  .button.primary:hover {
    border-color: transparent;
    background: var(--primary-hover);
    box-shadow: var(--halo);
  }

  .button svg {
    width: 17px;
    height: 17px;
    transition: translate var(--ease);
  }

  .button:hover svg {
    translate: 0 2px;
  }

  @media (max-width: 900px) {
    .frame {
      padding: 64px 20px;
    }
  }
</style>
