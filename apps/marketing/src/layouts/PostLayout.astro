---
// Standalone layout for long-form blog posts. It skips the marketing Layout on purpose: that
// layout still carries T3 Code's nav, stats, and links. Colors and type follow the app redesign
// (IBM Plex, flat neutrals). Set `draft` while editor notes remain so search engines skip the page.

interface Props {
  readonly title: string;
  readonly description: string;
  readonly image: string;
  readonly draft?: boolean;
}

const { title, description, image, draft = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {draft && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/cadsense-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="post-nav">
      <a href="/" class="post-nav-brand">Cadsense</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="post-footer">
      <span>&copy; 2026 Advait Johari · MIT licensed</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --canvas: #191919;
    --chrome: #101010;
    --surface: #1f1f1f;
    --surface-raised: #262626;
    --text: #f2f2f2;
    --text-body: #e2e2e2;
    --text-muted: #a3a3a3;
    --text-dim: #8a8a8a;
    --border: #2d2d2d;
    --border-strong: #3d3d3d;
    --marker: #fde68a;
    --font-sans: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --measure: 680px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--canvas);
  }

  body {
    margin: 0;
    background: var(--canvas);
    color: var(--text-body);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--text);
  }

  img,
  video,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .post-nav,
  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 24px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .post-nav a,
  .post-footer a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .post-nav a:hover,
  .post-footer a:hover {
    color: var(--text);
  }

  .post-nav-brand {
    font-weight: 600;
    color: var(--text) !important;
  }

  .post-footer {
    border-top: 1px solid var(--border);
    margin-top: 96px;
    padding-top: 28px;
    padding-bottom: 48px;
  }

  :focus-visible {
    outline: 2px solid var(--marker);
    outline-offset: 2px;
  }
</style>
