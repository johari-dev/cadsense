---
// Layout for long-form blog posts. It uses the site's shell, nav and footer, and sets the post in a
// band and frame like a section of the home page: a rule under the nav, and side borders that run
// the length of the article. The post supplies its own column and type.
// Set `draft` while editor notes remain so search engines skip the page.
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteLayout from "./SiteLayout.astro";

interface Props {
  readonly title: string;
  readonly description: string;
  readonly image: string;
  readonly draft?: boolean;
}

const { title, description, image, draft = false } = Astro.props;
---

<SiteLayout title={title} description={description} image={image} type="article" noindex={draft}>
  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <SiteNav />
  <main class="band">
    <div class="frame article">
      <slot />
    </div>
  </main>
  <SiteFooter />
</SiteLayout>

<style>
  /* No side padding: the post centres its own column, and its wide figures reach past that column. */
  .article {
    padding: 56px 0 112px;
  }

  @media (max-width: 900px) {
    .article {
      padding: 32px 0 72px;
    }
  }
</style>
