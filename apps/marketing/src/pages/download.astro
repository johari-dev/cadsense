---
// The downloads page: every installer Cadsense ships, one card per platform. A script fills in the
// build on offer from GitHub releases (lib/releases.ts). A card whose installer that build does not
// have says so. The card for the visitor's own platform is marked and gets the white button.
// Until the script runs, and if GitHub cannot be reached, every button goes to the releases page.
import PlatformIcon from "../components/PlatformIcon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import WorksWith from "../components/WorksWith.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { DOWNLOADS, RELEASES_URL } from "../lib/releases";
---

<SiteLayout title="Download Cadsense" description="Download Cadsense for macOS or Windows.">
  <SiteNav />
  <main class="band">
    <div class="frame flush">
      <div class="intro">
        <h1>Download Cadsense</h1>
        <p class="status" data-release-status>Finding the latest build&hellip;</p>
      </div>

      <div class="grid">
        {
          DOWNLOADS.map(({ platform, name, detail, format }) => (
            <section class:list={["card", platform]} data-download-card={platform}>
              <PlatformIcon platform={platform} class="logo" />
              <h2>
                {name} <span class="yours">This computer</span>
              </h2>
              <p>
                {detail} &middot; {format}
              </p>
              <a class="button small" href={RELEASES_URL} data-download>
                Download
              </a>
              <p class="missing" data-missing hidden>
                Not available yet
              </p>
            </section>
          ))
        }
      </div>

      <div class="notes">
        <WorksWith />
        <a class="more" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
          Older builds on GitHub <span aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </main>
  <SiteFooter />
</SiteLayout>

<script>
  import { DOWNLOADS, fetchOfferedRelease } from "../lib/releases";

  const status = document.querySelector<HTMLElement>("[data-release-status]");

  async function showRelease() {
    const release = await fetchOfferedRelease();
    if (!status || !release) throw new Error("No release to offer");

    status.textContent =
      release.channel === "stable"
        ? `Version ${release.version}.`
        : `Nightly build ${release.version}.`;

    for (const { platform } of DOWNLOADS) {
      const card = document.querySelector(`[data-download-card="${platform}"]`);
      const link = card?.querySelector<HTMLAnchorElement>("[data-download]");
      const missing = card?.querySelector<HTMLElement>("[data-missing]");
      if (!link || !missing) continue;
      const url = release.assets[platform];
      if (url) link.href = url;
      link.hidden = !url;
      missing.hidden = Boolean(url);
    }
  }

  showRelease().catch(() => {
    if (status) status.textContent = "Could not load the latest build. Each button opens the releases page on GitHub.";
  });
</script>

<style>
  .intro {
    padding: 88px 58px 56px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.1rem, 3.4vw, 3.1rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .status {
    margin: 22px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-block: 1px solid var(--divide);
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 34px 28px 38px;
    border-right: 1px solid var(--divide);
  }

  .card:last-child {
    border-right: 0;
  }

  .logo {
    width: 30px;
    height: 30px;
  }

  h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 26px 0 0;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .card p {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--text-2);
  }

  .card .button,
  .card .missing {
    margin-top: 24px;
  }

  /* The browser's rule for `hidden` loses to .button's display, so restate it. */
  .card [hidden] {
    display: none;
  }

  .card .missing {
    padding: 8px 0;
    font-size: 14px;
    color: var(--dim);
  }

  /* The visitor's own platform, named by SiteLayout's `data-platform`: a tinted card, a "This
     computer" tag, and the white button. */
  .yours {
    display: none;
    padding: 2px 8px;
    border-radius: var(--round-chip);
    background: var(--tint);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--accent);
  }

  :global([data-platform="mac"]) .mac,
  :global([data-platform="windows"]) .windows {
    background: var(--row);
  }

  :global([data-platform="mac"]) .mac .yours,
  :global([data-platform="windows"]) .windows .yours {
    display: inline;
  }

  /* This computer's button is the white one, so it drops the plain button's glass. */
  :global([data-platform="mac"]) .mac .button,
  :global([data-platform="windows"]) .windows .button {
    border-color: transparent;
    background: var(--text);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    color: var(--page);
  }

  :global([data-platform="mac"]) .mac .button:hover,
  :global([data-platform="windows"]) .windows .button:hover {
    background: var(--primary-hover);
    box-shadow: var(--halo);
  }

  .notes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 40px;
    padding: 34px 58px 88px;
    font-size: 14px;
    color: var(--text-2);
  }

  @media (max-width: 900px) {
    .intro {
      padding: 56px 20px 40px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .card {
      padding: 28px 20px 30px;
      border-right: 0;
      border-bottom: 1px solid var(--divide);
    }

    .card:last-child {
      border-bottom: 0;
    }

    .notes {
      padding: 28px 20px 64px;
    }
  }
</style>
