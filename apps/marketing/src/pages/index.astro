---
// The Cadsense landing page. The document shell, theme, nav and footer are shared with the rest of
// the site (layouts/SiteLayout.astro). This file lays the sections out and owns the few styles they
// share. Each section is a component in components/landing.
import Closing from "../components/landing/Closing.astro";
import ComingSoon from "../components/landing/ComingSoon.astro";
import Faq from "../components/landing/Faq.astro";
import FeatureRows from "../components/landing/FeatureRows.astro";
import FeatureScript from "../components/landing/FeatureScript.astro";
import Hero from "../components/landing/Hero.astro";
import HeroWave from "../components/landing/HeroWave.astro";
import ReviewTour from "../components/landing/ReviewTour.astro";
import Revisions from "../components/landing/Revisions.astro";
import SectionRail from "../components/landing/SectionRail.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const title = "Cadsense: accelerate CAD review for FRC teams";
const description =
  "Cadsense does the first pass on every CAD revision, before your mentor sees it. Claude Code or Codex reviews Onshape, SolidWorks and STEP models and pins each comment to the exact part.";

// Each id is set on its section's root element.
const sections = [
  { id: "overview", label: "Overview" },
  { id: "tour", label: "Tour" },
  { id: "how", label: "How it works" },
  { id: "featurescript", label: "FeatureScript" },
  { id: "why", label: "Revisions" },
  { id: "soon", label: "Coming soon" },
  { id: "faq", label: "FAQ" },
  { id: "download", label: "Download" },
] as const;
---

<SiteLayout title={title} description={description}>
  <!-- The app screenshot's tag comes after the hero art's data, so start its download from the head. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/landing/app-review.webp"
    imagesrcset="/landing/app-review.webp 1440w, /landing/app-review-2880w.webp 2880w"
    imagesizes="(min-width: 1240px) 1172px, calc(100vw - 60px)"
    fetchpriority="high"
  />

  <!-- The hero art's script reads the nav's position as the page is parsed, so the nav comes first. -->
  <div class="top" id="overview">
    <SiteNav />
    <HeroWave />
    <Hero />
  </div>

  <main>
    <ReviewTour />
    <FeatureRows />
    <FeatureScript />
    <Revisions />
    <ComingSoon />
    <Faq />
    <Closing />
  </main>

  <SiteFooter />
  <SectionRail sections={sections} />
</SiteLayout>

<style is:global>
  /* Styles the landing sections share. `pad` gives a heading the frame's padding inside a flush frame. */
  main > .band:first-child {
    margin-top: 96px;
  }

  .pad {
    padding: 104px 58px 64px;
  }

  /* A section heading in two tones: wrap the first sentence in a span to dim it. */
  h2 {
    margin: 0;
    max-width: 15.5em;
    font-size: clamp(1.9rem, 2.9vw, 2.6rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }

  h2 span {
    color: var(--dim);
  }

  /* A heading on the left with a short paragraph on the right. */
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
  }

  .head p {
    margin: 0;
    max-width: 24rem;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-2);
  }

  @media (max-width: 900px) {
    main > .band:first-child {
      margin-top: 56px;
    }

    .pad {
      padding: 64px 20px 40px;
    }

    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>

<style>
  /* Holds the hero art, which is positioned against this box and clipped by it. */
  .top {
    position: relative;
    overflow: hidden;
  }
</style>
