---
// Not-found page. Standalone like the home page, in the app's colors and IBM Plex type (the same
// tokens as PostLayout). The still logo links home.
import Analytics from "@vercel/analytics/astro";

const title = "Page not found · Cadsense";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/cadsense-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <main>
      <a href="/" aria-label="Cadsense home">
        <img class="logo" src="/cadsense-logo.webp" alt="" width="72" height="72" />
      </a>
      <p class="code">404</p>
      <h1>This page doesn't exist</h1>
      <p class="lead">The link may be old, or the page may have moved.</p>
    </main>
  </body>
</html>

<style is:global>
  html,
  body {
    height: 100%;
    margin: 0;
  }

  body {
    background: #191919;
    color: #e2e2e2;
    color-scheme: dark;
    font-family: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
</style>

<style>
  main {
    display: grid;
    place-content: center;
    justify-items: center;
    min-height: 100%;
    padding: 24px;
    box-sizing: border-box;
    text-align: center;
  }

  .logo {
    width: 72px;
    height: 72px;
    object-fit: contain;
  }

  .code {
    margin: 28px 0 0;
    font: 12px "IBM Plex Mono", ui-monospace, monospace;
    letter-spacing: 0.02em;
    color: #a3a3a3;
  }

  h1 {
    margin: 10px 0 0;
    font-size: clamp(28px, 5vw, 36px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #f2f2f2;
  }

  .lead {
    margin: 12px 0 0;
    font-size: 17px;
    color: #a3a3a3;
  }
</style>
