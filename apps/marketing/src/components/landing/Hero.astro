---
// The landing page's headline block: the pitch, the two calls to action, what Cadsense works with,
// and the app window. It sits on top of HeroWave, so it carries its own shadow for readability.
import { LAUNCH_POST_PATH } from "../../lib/site";
import WorksWith from "../WorksWith.astro";
import DownloadLink from "./DownloadLink.astro";
---

<section class="hero">
  <a class="launch glass" href={LAUNCH_POST_PATH}>
    Read the launch post
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 9l6-6M4 3h5v5"></path>
    </svg>
  </a>
  <h1>Accelerate CAD review <br />for FRC teams</h1>
  <p class="lede">
    Cadsense does the first pass on every revision, before your mentor sees it. It catches the overlaps, tight
    clearances and missing bolts, so design review time goes to the design.
  </p>
  <div class="actions">
    <DownloadLink />
    <a class="button" href="#tour">Watch a review</a>
  </div>

  <WorksWith class="works" />

  <div class="tray">
    <img
      src="/landing/app-review.webp"
      srcset="/landing/app-review.webp 1440w, /landing/app-review-2880w.webp 2880w"
      sizes="(min-width: 1240px) 1172px, calc(100vw - 60px)"
      width="1440"
      height="900"
      fetchpriority="high"
      alt="Cadsense with three CAD projects in the sidebar, two of them with a review running, and a disc transfer open in the viewer with three review comments pinned to its parts"
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    padding: 86px 24px 0;
    text-align: center;
  }

  /* A light shadow of page colour behind the copy, so the headline does not sit on full-strength
     blue. It is a blurred block the size of the text column and it does not animate, so the blur is
     painted once. The art stays visible through it. The copy also carries a soft text shadow. */
  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 120px;
    width: min(700px, 88vw);
    height: 400px;
    translate: -50% 0;
    border-radius: 140px;
    background: var(--page);
    opacity: 0.58;
    filter: blur(52px);
  }

  h1,
  .lede {
    text-shadow: 0 0 18px color-mix(in oklab, var(--page) 75%, transparent);
  }

  /* A full pill, unlike the buttons, so it reads as an announcement and not as a button. */
  .launch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: var(--round-pill);
    font-size: 14px;
    font-weight: 500;
  }

  .launch svg {
    width: 12px;
    height: 12px;
    opacity: 0.6;
    transition:
      translate var(--ease),
      opacity var(--ease);
  }

  .launch:hover svg {
    translate: 1.5px -1.5px;
    opacity: 1;
  }

  h1 {
    margin: 34px auto 0;
    max-width: 15em;
    font-size: clamp(2.5rem, 4.15vw, 4.75rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .lede {
    margin: 26px auto 0;
    max-width: 36rem;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
  }

  .works {
    justify-content: center;
    margin-top: 28px;
  }

  /* Pushed down from the copy so the art has room to fade out above the app window. */
  .tray {
    max-width: 1192px;
    margin: 118px auto 0;
    padding: 10px;
    border: 1px solid var(--divide);
    border-radius: var(--round-panel);
    background: var(--elev);
  }

  .tray img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--round-card);
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 56px;
    }

    h1 br {
      display: none;
    }

    .lede {
      font-size: 16px;
    }

    .tray {
      margin-top: 64px;
      padding: 6px;
      border-radius: var(--round-card);
    }

    .tray img {
      border-radius: var(--round-chip);
    }
  }
</style>
