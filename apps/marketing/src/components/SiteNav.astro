---
// The site's top bar: the logo, a capsule of links, and the GitHub and Downloads actions. Downloads goes
// to the page that lists every installer. The section links point at the home page's sections, so
// they work from any page. `data-site-nav` lets the home page's hero art find the bar and stay clear
// of it.
import { GITHUB_REPOSITORY_URL, LAUNCH_POST_PATH } from "../lib/site";
---

<header class="nav" data-site-nav>
  <a class="brand" href="/">
    <img src="/landing/logo.webp" alt="" width="22" height="22" />
    Cadsense
  </a>
  <nav class="links glass" aria-label="Site">
    <a href="/#tour">Tour</a>
    <a href="/#how">How it works</a>
    <a href="/#faq">FAQ</a>
    <a href={LAUNCH_POST_PATH}>Launch post</a>
  </nav>
  <div class="actions">
    <a class="github" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"></path>
      </svg>
      GitHub
    </a>
    <a class="button small primary" href="/download">Downloads</a>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 1240px;
    margin: 0 auto;
    padding: 16px 0;
  }

  .links {
    display: flex;
    gap: 4px;
    padding: 5px;
    border-radius: var(--round-control);
    font-size: 14px;
    font-weight: 500;
  }

  .links a,
  .github {
    padding: 7px 14px;
    border-radius: var(--round-chip);
    transition: background-color var(--ease);
  }

  .links a:hover,
  .github:hover {
    background: var(--tint);
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
  }

  .github {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .github svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 1280px) {
    .nav {
      padding-inline: 24px;
    }
  }

  @media (max-width: 900px) {
    .nav {
      grid-template-columns: 1fr auto;
    }

    .links {
      display: none;
    }
  }
</style>
